{
  "name": "capacitor-app",
  "version": "1.0.0",
  "description": "An Amazing Capacitor App",
  "type": "module",
  "keywords": [
    "capacitor",
    "mobile"
  ],
  "scripts": {
    "start": "vite",
    "build": "npm install ./capacitor-android-shell-exec && npm install ./ && cd capacitor-android-shell-exec && npm run build && cd ../ && vite build && npx cap sync",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/camera": "latest",
    "@capacitor/core": "latest",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/splash-screen": "latest",
    "capacitor-android-shell-exec": "file:capacitor-android-shell-exec"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "vite": "^7.3.1"
  },
  "author": "",
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
